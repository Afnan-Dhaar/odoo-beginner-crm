<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_my_first_customer_note_list" model="ir.ui.view">
        <field name="name">my.first.customer.note.list</field>
        <field name="model">my.first.customer.note</field>

        <field name="arch" type="xml">
            <list string="Customer Notes">
                <field name="customer_id"/>
                <field name="title"/>
                <field name="note_type"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="follow_up_date"/>
                <field name="contacted"/>
                <field name="is_overdue"/>
                <field name="created_at"/>
                <field name="updated_at"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <record id="view_my_first_customer_note_form" model="ir.ui.view">
        <field name="name">my.first.customer.note.form</field>
        <field name="model">my.first.customer.note</field>
        <field name="arch" type="xml">
            <form string="Customer Note">
                <header>
                    <button name="action_mark_done" string="Mark Done" type="object" class="btn-primary" invisible="status != 'open'"/>
                    <button name="action_mark_contacted" string="Mark Contacted" type="object" class="btn-secondary" invisible="contacted"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,done,cancelled"/>
                </header>
                <sheet>
                    <group string="Note Details">
                        <field name="customer_id"/>
                        <field name="title"/>
                        <field name="note_type"/>
                        <field name="priority"/>
                        <field name="follow_up_date"/>
                        <field name="contacted"/>
                        <field name="is_overdue" readonly="1"/>
                    </group>
                    <field name="note" placeholder="Write the customer note here..."/>
                    <group string="Tracking">
                        <field name="created_by" readonly="1"/>
                        <field name="created_at" readonly="1"/>
                        <field name="updated_at" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_my_first_customer_note_search" model="ir.ui.view">
        <field name="name">my.first.customer.note.search</field>
        <field name="model">my.first.customer.note</field>
        <field name="arch" type="xml">
            <search string="Search Customer Notes">
                <field name="customer_id"/>
                <field name="title"/>
                <field name="note_type"/>
                <separator/>
                <filter name="open" string="Open" domain="[('status', '=', 'open')]"/>
                <filter name="done" string="Done" domain="[('status', '=', 'done')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="not_contacted" string="Not Contacted" domain="[('contacted', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'note_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_my_first_customer_note" model="ir.actions.act_window">
        <field name="name">Customer Notes</field>
        <field name="res_model">my.first.customer.note</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_my_first_customer_note_search"/>
    </record>

    <menuitem
        id="menu_my_first_customer_note"
        name="Customer Notes"
        action="action_my_first_customer_note"
        parent="menu_my_first_customer_root"
        sequence="3"
    />

</odoo>