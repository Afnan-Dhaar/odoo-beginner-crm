<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ============================= -->
    <!-- Customer List View             -->
    <!-- ============================= -->

    <record id="view_my_first_customer_list" model="ir.ui.view">
        <field name="name">my.first.customer.list</field>
        <field name="model">my.first.customer</field>

        <field name="arch" type="xml">
           <list string="Customers">
           <header>
                <!-- <button
                    name="action_search_active_customers"
                    string="Search Active Customers"
                    type="object"
                    class="btn-secondary"
                />
                <button
                    name="action_search_active_company_customers"
                    string="Active + Aseef Customers"
                    type="object"
                    class="btn-secondary"
                />
                <button
                    name="action_search_new_or_inactive_customers"
                    string="New OR Inactive"
                    type="object"
                    class="btn-secondary"
                />
                <button
                    name="action_search_active_company_or_new"
                    string="Active + Aseef OR New"
                    type="object"
                    class="btn-secondary"
                /> -->
            </header>
            <field name="reference"/>
            <field name="name"/>
            <field name="company_name"/>
            <field name="display_name"/>
            <field name="email"/>
            <field name="phone"/>
            <field name="category"/>
            <field name="status"/>
            </list>
        </field>
    </record>
    <!-- ============================= -->
    <!-- Customer Search View          -->
    <!-- ============================= -->

    <record id="view_my_first_customer_search" model="ir.ui.view">
        <field name="name">my.first.customer.search</field>
        <field name="model">my.first.customer</field>

        <field name="arch" type="xml">
            <search string="Search Customers">

            <field name="name"/>
            <field name="reference"/>
            <field name="email"/>
            <field name="phone"/>
            <field name="company_name"/>
            <field name="category"/>

                <separator/>

                <filter
                    name="filter_new"
                    string="New"
                    domain="[('status', '=', 'new')]"
                />

                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('status', '=', 'active')]"
                />

                <filter
                    name="filter_inactive"
                    string="Inactive"
                    domain="[('status', '=', 'inactive')]"
                />

                <separator/>

                <group>
                    <filter
                        name="group_by_status"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />

                    <filter
                        name="group_by_company"
                        string="Company Name"
                        context="{'group_by': 'company_name'}"
                    />
                </group>

            </search>
        </field>
    </record>

    <!-- ============================= -->
    <!-- Customer Form View             -->
    <!-- ============================= -->

    <record id="view_my_first_customer_form" model="ir.ui.view">
        <field name="name">my.first.customer.form</field>
        <field name="model">my.first.customer</field>

        <field name="arch" type="xml">
            <form string="Customer">

            <header>
                    <button
                name="action_activate"
                string="Activate"
                type="object"
                class="btn-primary"
                invisible="status == 'active'"
                    />
                    <button
                name="action_deactivate"
                string="Deactivate"
                type="object"
                class="btn-secondary"
                invisible="status != 'active'"
                    />
                    <button
                name="action_refresh_timeline"
                string="Refresh Timeline"
                type="object"
                class="btn-secondary"
                    />
                    <button
                name="action_send_email"
                string="Send Email"
                type="object"
                class="btn-secondary"
                    />
                    <button
                name="action_print_statement"
                string="Print Statement"
                type="object"
                class="btn-secondary"
                    />
    <!-- <button
    name="action_test_multiple_create"
    string="Test Multiple Create"
    type="object"
    class="btn-secondary"
/> -->
            </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_view_emails" type="object" class="oe_stat_button" icon="fa-envelope">
                            <field name="email_count" widget="statinfo" string="Emails"/>
                        </button>
                    </div>

                    <!-- Customer Information -->
                <group string="Customer Information">
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="website"/>
                    <field name="company_id"/>
                    <field name="company_name"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <field name="status"/>
                    <field name="last_contact_date" readonly="1"/>
                    <field name="last_updated" readonly="1"/>
                    <field name="created_at" readonly="1"/>
                </group>
                <group string="Address">
                    <field name="street"/>
                    <field name="street2"/>
                    <field name="city"/>
                    <field name="state"/>
                    <field name="zip"/>
                    <field name="country"/>
                </group>
                <group string="Financial Summary">
                    <field name="currency_id" invisible="1"/>
                    <field name="total_invoiced" readonly="1"/>
                    <field name="total_paid" readonly="1"/>
                    <field name="total_due" readonly="1"/>
                </group>
                <notebook>
                    <page string="Notes">
                        <field name="note_ids">
                            <list editable="bottom">
                                <button
                                    name="action_mark_done"
                                    string="Mark Done"
                                    type="object"
                                    invisible="status == 'done'"
                                />
                                <button
                                    name="action_mark_contacted"
                                    string="Mark Contacted"
                                    type="object"
                                    invisible="contacted"
                                    class="btn-secondary"
                                />
                                <field name="title"/>
                                <field name="note" widget="text"/>
                                <field name="note_type"/>
                                <field name="status"/>
                                <field name="priority"/>
                                <field name="follow_up_date"/>
                                <field name="contacted"/>
                                <field name="created_at" readonly="1"/>
                                <field name="updated_at" readonly="1"/>
                                <field name="created_by" readonly="1"/>
                            </list>
                        </field>
                    </page>
                    <page string="Activities">
                        <field name="activity_ids">
                            <list>
                                <button
                                    name="action_mark_done"
                                    string="Mark Done"
                                    type="object"
                                    invisible="status != 'planned'"
                                />
                                <button
                                    name="action_cancel"
                                    string="Cancel"
                                    type="object"
                                    invisible="status != 'planned'"
                                    class="btn-secondary"
                                />
                                <field name="title"/>
                                <field name="activity_type"/>
                                <field name="status"/>
                                <field name="priority"/>
                                <field name="due_date"/>
                                <field name="assigned_to"/>
                            </list>
                        </field>
                    </page>
                    <page string="Invoices">
                        <field name="invoice_ids">
                            <list>
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="due_date"/>
                                <field name="amount_total"/>
                                <field name="amount_paid"/>
                                <field name="amount_due"/>
                                <field name="payment_status"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                    <page string="Documents">
                        <field name="document_ids" context="{'default_customer_id': id}">
                            <list>
                                <field name="name"/>
                                <field name="document_type"/>
                                <field name="file_name"/>
                                <field name="file" widget="binary" filename="file_name"/>
                                <field name="invoice_id"/>
                                <field name="created_at"/>
                                <field name="created_by"/>
                            </list>
                        </field>
                    </page>
                    <page string="Emails">
                        <field name="email_ids" context="{'default_customer_id': id, 'default_recipient': email}">
                            <list>
                                <field name="date"/>
                                <field name="subject"/>
                                <field name="recipient"/>
                                <field name="direction"/>
                                <field name="state"/>
                                <field name="invoice_id"/>
                                <field name="author_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Timeline">
                        <field name="timeline_ids">
                            <list create="0" edit="0" delete="0">
                                <field name="event_date"/>
                                <field name="event_type"/>
                                <field name="title"/>
                                <field name="description"/>
                                <field name="source_ref"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <!-- ============================= -->
    <!-- Customer Window Action         -->
    <!-- ============================= -->

    <record id="action_my_first_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">my.first.customer</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ============================= -->
    <!-- Customer Menu                 -->
    <!-- ============================= -->

    <menuitem
        id="menu_my_first_customer_root"
        name="Customers"
        sequence="10"
    />

    <menuitem
        id="menu_my_first_customer"
        name="Customers"
        action="action_my_first_customer"
        parent="menu_my_first_customer_root"
        sequence="1"
    />

</odoo>