<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_my_first_customer_invoice_list" model="ir.ui.view">
        <field name="name">my.first.customer.invoice.list</field>
        <field name="model">my.first.customer.invoice</field>
        <field name="arch" type="xml">
            <list string="Customer Invoices">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="currency_id"/>
                <field name="amount_total"/>
                <field name="amount_paid"/>
                <field name="amount_due"/>
                <field name="amount_total_company" string="Total (Company)" optional="show"/>
                <field name="payment_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_my_first_customer_invoice_form" model="ir.ui.view">
        <field name="name">my.first.customer.invoice.form</field>
        <field name="model">my.first.customer.invoice</field>
        <field name="arch" type="xml">
            <form string="Customer Invoice">
                <header>
                    <button name="action_post" string="Post" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state != 'cancelled'"/>
                    <button name="action_send_email" string="Send Email" type="object" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_print_invoice" string="Print Invoice" type="object" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_view_emails" type="object" class="oe_stat_button" icon="fa-envelope">
                            <field name="email_count" widget="statinfo" string="Emails"/>
                        </button>
                    </div>
                    <group string="Invoice Details">
                        <field name="name" readonly="1"/>
                        <field name="customer_id" readonly="state != 'draft'"/>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="is_foreign_currency" invisible="1"/>
                        <field name="currency_id" readonly="state != 'draft'"/>
                        <field name="exchange_rate" invisible="not is_foreign_currency" readonly="state != 'draft'"/>
                        <field name="invoice_date" readonly="state != 'draft'"/>
                        <field name="due_date" readonly="state != 'draft'"/>
                        <field name="amount_total" readonly="state != 'draft'"/>
                        <field name="payment_status" readonly="1"/>
                    </group>
                    <group string="Payment Summary">
                        <field name="amount_paid" readonly="1"/>
                        <field name="amount_due" readonly="1"/>
                        <field name="amount_total_company" invisible="not is_foreign_currency" readonly="1"/>
                        <field name="amount_paid_company" invisible="not is_foreign_currency" readonly="1"/>
                        <field name="amount_due_company" invisible="not is_foreign_currency" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payment_ids">
                                <list editable="bottom">
                                    <field name="payment_date"/>
                                    <field name="amount"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="amount_company" string="Amount (Company)" optional="show" readonly="1"/>
                                    <field name="payment_method"/>
                                    <field name="reference"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="document_ids" context="{'default_customer_id': customer_id, 'default_invoice_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="file_name"/>
                                    <field name="file" widget="binary" filename="file_name"/>
                                    <field name="created_at"/>
                                    <field name="created_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="Emails">
                            <field name="email_ids" context="{'default_customer_id': customer_id, 'default_invoice_id': id, 'default_recipient': customer_id.email}">
                                <list>
                                    <field name="date"/>
                                    <field name="subject"/>
                                    <field name="recipient"/>
                                    <field name="direction"/>
                                    <field name="state"/>
                                    <field name="author_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_my_first_customer_invoice_search" model="ir.ui.view">
        <field name="name">my.first.customer.invoice.search</field>
        <field name="model">my.first.customer.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Customer Invoices">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="currency_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="not_paid" string="Not Paid" domain="[('payment_status', '=', 'not_paid')]"/>
                <filter name="partially_paid" string="Partially Paid" domain="[('payment_status', '=', 'partially_paid')]"/>
                <filter name="paid" string="Paid" domain="[('payment_status', '=', 'paid')]"/>
                <filter name="foreign_currency" string="Foreign Currency" domain="[('is_foreign_currency', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_by_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                    <filter name="group_by_status" string="Payment Status" context="{'group_by': 'payment_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_my_first_customer_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">my.first.customer.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_my_first_customer_invoice_search"/>
    </record>

    <menuitem
        id="menu_my_first_customer_invoice"
        name="Invoices"
        action="action_my_first_customer_invoice"
    />

</odoo>