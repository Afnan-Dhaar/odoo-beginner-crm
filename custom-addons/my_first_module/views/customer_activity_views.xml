<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_my_first_customer_activity_list" model="ir.ui.view">
        <field name="name">my.first.customer.activity.list</field>
        <field name="model">my.first.customer.activity</field>
        <field name="arch" type="xml">
            <list string="Customer Activities">
                <button
                    name="action_mark_done"
                    string="Mark Done"
                    type="object"
                    invisible="status != 'planned'"
                />
                <field name="customer_id"/>
                <field name="title"/>
                <field name="activity_type"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="assigned_to"/>
                <field name="is_overdue"/>
            </list>
        </field>
    </record>

    <record id="view_my_first_customer_activity_form" model="ir.ui.view">
        <field name="name">my.first.customer.activity.form</field>
        <field name="model">my.first.customer.activity</field>
        <field name="arch" type="xml">
            <form string="Customer Activity">
                <header>
                    <button
                        name="action_mark_done"
                        string="Mark Done"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'planned'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"
                        invisible="status != 'planned'"
                    />
                    <button
                        name="action_set_planned"
                        string="Set Planned"
                        type="object"
                        class="btn-secondary"
                        invisible="status == 'planned'"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="planned,done,cancelled"/>
                </header>
                <sheet>
                    <group string="Activity Details">
                        <field name="customer_id"/>
                        <field name="title"/>
                        <field name="activity_type"/>
                        <field name="assigned_to"/>
                        <field name="due_date"/>
                        <field name="priority"/>
                        <field name="description"/>
                        <field name="is_overdue" readonly="1"/>
                    </group>
                    <group string="Tracking">
                        <field name="created_by" readonly="1"/>
                        <field name="created_at" readonly="1"/>
                        <field name="completed_at" readonly="1"/>
                        <field name="completed_by" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_my_first_customer_activity_search" model="ir.ui.view">
        <field name="name">my.first.customer.activity.search</field>
        <field name="model">my.first.customer.activity</field>
        <field name="arch" type="xml">
            <search string="Search Activities">
                <field name="customer_id"/>
                <field name="title"/>
                <field name="assigned_to"/>
                <field name="activity_type"/>
                <separator/>
                <filter name="my_activities" string="My Activities" domain="[('assigned_to', '=', uid)]"/>
                <filter name="planned" string="Planned" domain="[('status', '=', 'planned')]"/>
                <filter name="done" string="Done" domain="[('status', '=', 'done')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'activity_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_assigned_to" string="Assigned To" context="{'group_by': 'assigned_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_my_first_customer_activity_calendar" model="ir.ui.view">
        <field name="name">my.first.customer.activity.calendar</field>
        <field name="model">my.first.customer.activity</field>
        <field name="arch" type="xml">
            <calendar string="Customer Activities" date_start="due_date" color="activity_type">
                <field name="title"/>
                <field name="customer_id"/>
                <field name="activity_type"/>
                <field name="status"/>
                <field name="assigned_to"/>
            </calendar>
        </field>
    </record>

    <record id="action_my_first_customer_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">my.first.customer.activity</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_my_first_customer_activity_search"/>
    </record>

    <menuitem
        id="menu_my_first_customer_activity"
        name="Activities"
        action="action_my_first_customer_activity"
    />

</odoo>