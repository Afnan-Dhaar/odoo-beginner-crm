<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_my_first_crm_dashboard_kanban" model="ir.ui.view">
        <field name="name">my.first.crm.dashboard.kanban</field>
        <field name="model">my.first.crm.dashboard</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0">
                <field name="customer_count"/>
                <field name="active_customer_count"/>
                <field name="open_activity_count"/>
                <field name="overdue_activity_count"/>
                <field name="unpaid_invoice_count"/>
                <field name="outstanding_amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title mb-3">
                                <strong>CRM Dashboard</strong>
                            </div>
                            <div class="row g-3">
                                <div class="col-4">
                                    <button type="object" name="action_open_customers" class="btn btn-link p-0 text-start">
                                        <div class="text-muted">Customers</div>
                                        <strong class="fs-3"><field name="customer_count"/></strong>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="object" name="action_open_active_customers" class="btn btn-link p-0 text-start">
                                        <div class="text-muted">Active Customers</div>
                                        <strong class="fs-3"><field name="active_customer_count"/></strong>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="object" name="action_open_activities" class="btn btn-link p-0 text-start">
                                        <div class="text-muted">Open Activities</div>
                                        <strong class="fs-3"><field name="open_activity_count"/></strong>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="object" name="action_open_overdue_activities" class="btn btn-link p-0 text-start">
                                        <div class="text-muted">Overdue Activities</div>
                                        <strong class="fs-3 text-danger"><field name="overdue_activity_count"/></strong>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="object" name="action_open_unpaid_invoices" class="btn btn-link p-0 text-start">
                                        <div class="text-muted">Unpaid Invoices</div>
                                        <strong class="fs-3"><field name="unpaid_invoice_count"/></strong>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted">Outstanding Amount</div>
                                    <strong class="fs-3"><field name="outstanding_amount"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_my_first_crm_dashboard" model="ir.actions.act_window">
        <field name="name">CRM Dashboard</field>
        <field name="res_model">my.first.crm.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="res_id" ref="crm_dashboard_record"/>
    </record>

    <menuitem
        id="menu_my_first_crm_dashboard"
        name="CRM Dashboard"
        action="action_my_first_crm_dashboard"
        sequence="1"
    />

</odoo>