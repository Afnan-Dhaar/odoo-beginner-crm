<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_my_first_crm_dashboard_form" model="ir.ui.view">
        <field name="name">my.first.crm.dashboard.form</field>
        <field name="model">my.first.crm.dashboard</field>
        <field name="arch" type="xml">
            <form string="CRM Dashboard" create="0" edit="0" delete="0">
                <header>
                    <button name="action_create_customer" string="New Customer" type="object" class="btn-primary"/>
                    <button name="action_create_activity" string="New Activity" type="object" class="btn-secondary"/>
                    <button name="action_create_invoice" string="New Invoice" type="object" class="btn-secondary"/>
                    <button name="action_send_email" string="Send Email" type="object" class="btn-secondary"/>
                    <button name="action_create_document" string="Upload Document" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>CRM Dashboard</h1>
                        <p class="text-muted">A live overview of customers, follow-ups, communications, and finances.</p>
                    </div>
                    <field name="currency_id" invisible="1"/>

                    <!-- KPI Cards Row 1: Customers & Communications -->
                    <div class="o_row o_dashboard_kpi_row">
                        <button name="action_open_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="customer_count" widget="statinfo" string="Customers"/>
                        </button>
                        <button name="action_open_active_customers" type="object" class="oe_stat_button" icon="fa-user-check">
                            <field name="active_customer_count" widget="statinfo" string="Active Customers"/>
                        </button>
                        <button name="action_open_emails" type="object" class="oe_stat_button" icon="fa-envelope">
                            <field name="email_count" widget="statinfo" string="Emails Logged"/>
                        </button>
                        <button name="action_open_documents" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>

                    <!-- KPI Cards Row 2: Activities & Financials -->
                    <div class="o_row o_dashboard_kpi_row">
                        <button name="action_open_activities" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="open_activity_count" widget="statinfo" string="Open Activities"/>
                        </button>
                        <button name="action_open_overdue_activities" type="object" class="oe_stat_button text-danger" icon="fa-clock-o">
                            <field name="overdue_activity_count" widget="statinfo" string="Overdue Activities"/>
                        </button>
                        <button name="action_open_paid_invoices" type="object" class="oe_stat_button text-success" icon="fa-check-circle">
                            <field name="total_paid_amount" widget="statinfo" string="Total Collected"/>
                        </button>
                        <button name="action_open_unpaid_invoices" type="object" class="oe_stat_button text-danger" icon="fa-money">
                            <field name="outstanding_amount" widget="statinfo" string="Outstanding Due"/>
                        </button>
                    </div>

                    <separator string="Follow-up Overview"/>
                    <div class="o_row">
                        <group string="Recent Activities" class="o_col-6">
                            <field name="recent_activity_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="title"/>
                                    <field name="customer_id"/>
                                    <field name="activity_type"/>
                                    <field name="status"/>
                                    <field name="due_date"/>
                                </list>
                            </field>
                        </group>
                        <group string="Upcoming Follow-ups" class="o_col-6">
                            <field name="upcoming_activity_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="title"/>
                                    <field name="customer_id"/>
                                    <field name="activity_type"/>
                                    <field name="priority"/>
                                    <field name="due_date" decoration-danger="priority in ['urgent', 'high']"/>
                                </list>
                            </field>
                        </group>
                    </div>

                    <separator string="Communications &amp; Documents"/>
                    <div class="o_row">
                        <group string="Recent Emails" class="o_col-6">
                            <field name="recent_email_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="subject"/>
                                    <field name="customer_id"/>
                                    <field name="direction"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </group>
                        <group string="Recent Documents" class="o_col-6">
                            <field name="recent_document_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="customer_id"/>
                                    <field name="file_name"/>
                                    <field name="created_at"/>
                                </list>
                            </field>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_my_first_crm_dashboard" model="ir.actions.act_window">
        <field name="name">CRM Dashboard</field>
        <field name="res_model">my.first.crm.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="crm_dashboard_record"/>
    </record>

    <menuitem
        id="menu_my_first_crm_dashboard"
        name="CRM Dashboard"
        action="action_my_first_crm_dashboard"
        sequence="1"
    />

</odoo>