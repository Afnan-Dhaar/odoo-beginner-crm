<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Company List View -->
    <record id="view_my_first_company_list" model="ir.ui.view">
        <field name="name">my.first.company.list</field>
        <field name="model">my.first.company</field>
        <field name="arch" type="xml">
            <list string="Companies">
                <field name="name"/>
                <field name="industry"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="customer_count"/>
                <field name="active_customer_count"/>
            </list>
        </field>
    </record>


    <!-- Company Form View -->
    <record id="view_my_first_company_form" model="ir.ui.view">
        <field name="name">my.first.company.form</field>
        <field name="model">my.first.company</field>
        <field name="arch" type="xml">
        <form string="Company">
                <sheet>
                    <group string="Company Information">
                        <field name="name"/>
                        <field name="industry"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="website"/>
                    </group>
                    <group string="Address">
                        <field name="street"/>
                        <field name="city"/>
                        <field name="state"/>
                        <field name="zip"/>
                        <field name="country"/>
                    </group>
                    <group string="Customer Summary">
                        <field name="customer_count" readonly="1"/>
                        <field name="active_customer_count" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Customers">
                            <field name="customer_ids">
                                <list>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
        </form>
        </field>
    </record>


    <!-- Company Action -->
    <record id="action_my_first_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">my.first.company</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Company Menu -->
    <menuitem
        id="menu_my_first_company"
        name="Companies"
        action="action_my_first_company"
        parent="menu_my_first_customer_root"
        sequence="2"
    />

</odoo>